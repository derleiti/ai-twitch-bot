# Zephyr server profile - copy to .env and configure credentials separately.
ENABLE_TWITCH=true
ENABLE_YOUTUBE=false
ENABLE_VISION=true
VISION_PROVIDER=triforce
AI_ORDER=triforce
AI_MODE=first
TRIFORCE_BASE=http://172.17.0.1:9000/v1/openai
TRIFORCE_TEXT_MODELS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/nvidia/nemotron-3.5-lightning:free
TRIFORCE_VISION_MODELS=openrouter/nvidia/nemotron-3.5-super-vl:free,openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SCREENSHOT_FILE=/home/your-user/.local/state/zephyr/frames/current_screenshot.jpg
SCREENSHOT_DIR=/home/your-user/.local/state/zephyr/frames
VISION_MAX_FRAME_AGE_SEC=60
SCREENSHOT_ANALYSIS_INTERVAL=10
TICK_JITTER_SEC=1
CHAT_GLOBAL_COOLDOWN_SEC=180
POST_BUDGET_ENABLED=true
POST_BUDGET_WINDOW_SEC=600
POST_BUDGET_MAX_MSGS=10
POST_BUDGET_VISION_WINDOW_SEC=600
POST_BUDGET_VISION_MAX_MSGS=4
POST_BUDGET_COMMAND_WINDOW_SEC=120
POST_BUDGET_COMMAND_MAX_MSGS=6
TWITCH_HELP_ENABLED=false
TWITCH_SEND_HELLO=false
AUTO_VISION_ON_START=false
TWITCH_RANDOM_REPLY=false
TWITCH_CHANNEL=your_channel
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=
TRIFORCE_USER=
TRIFORCE_PASSWORD=
HEALTH_INCLUDE_QWEN=false
HEALTH_INCLUDE_AUTH=false
