[Unit]
Description=Zephyr primary monitor screenshot upload (manual streaming session)
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=zephyr-capture.service
[Service]
Type=simple
ExecStart=/bin/bash %h/.local/share/zephyr-capture/spectacle_capture.sh
Environment=ZEPHYR_CAPTURE_INTERVAL=30
EnvironmentFile=-%h/.config/zephyr-capture/capture.env
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
UMask=0077
